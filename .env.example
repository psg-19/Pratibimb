# Copy to .env (never commit it) and fill in what you need.

# Enables the AI features (meal photos, Ask your twin, record extraction, drafts, planner).
# Without it the app still works: twin forecasts, what-ifs and triage are all local.
# Get a key at https://aistudio.google.com/apikey. On the free tier Google may use what you send
# to improve its products and human reviewers may read it: send synthetic data only.
GEMINI_API_KEY=
# Gemini model for all AI features (gemini-3.5-flash-lite has higher free-tier limits).
AI_MODEL=gemini-3.8-flash

# Demo clock: start time (IST) and speed (simulated minutes per real minute).
DEMO_START=2026-10-13T21:40
DEMO_SPEED=15

PORT=8787
HOST=127.0.0.1
DB_FILE=./data/pratibimb.db
# Set to false when serving production over plain HTTP (e.g. a LAN demo); keep true behind HTTPS.
COOKIE_SECURE=
