{
  "name": "pratibimb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pratibimb — a type 2 diabetes digital twin, proof-of-concept web prototype. Synthetic data; not a medical device.",
  "license": "MIT",
  "scripts": {
    "tokens": "node scripts/gen-tokens.mjs",
    "dev": "npm run tokens && concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "vite",
    "seed:reset": "tsx server/index.ts --reset",
    "build": "npm run tokens && tsc -b && vite build && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run tokens && npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@google/genai": "^2.30.0",
    "better-sqlite3": "^11.5.0",
    "fastify": "^4.28.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "9.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
